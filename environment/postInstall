#!/usr/bin/env bash
set -ex

# Python 3.11 and the JVM go in their own environment. Changing the base environment's
# Python replaces libraries mamba itself is linked against, which breaks every later
# mamba call. aind-morphology-utils needs numpy<1.24, which cannot build on 3.12.
mamba create -y -n morphology -c conda-forge \
  python=3.11 \
  pip \
  openjdk=21 \
  pyimagej==1.6.0 \
  scyjava==1.12.0

mamba clean -afy

# jgo<3: scyjava 1.12.0 imports maven_scijava_repository, which jgo 3 removed.
# The library is pinned to a commit so a cached layer cannot hide a change.
/opt/conda/envs/morphology/bin/python -m pip install --no-cache-dir \
  boto3==1.41.5 \
  botocore==1.41.5 \
  aiobotocore==2.26.0 \
  jgo==2.2.0 \
  "git+https://github.com/AllenNeuralDynamics/neuron-tracing-utils.git@f1cf99eb9767c0eb345166ea216c7c6b3fa6ccab" \
  "exaspim-swc-processing @ git+https://github.com/peter-grotz/exaspim-swc-processing.git@946f7a47c975fdcb189f6e60163d8125741227dd"
