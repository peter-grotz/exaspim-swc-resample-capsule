#!/usr/bin/env bash
set -ex

pip list > /results/pip_list.txt

# neuron_tracing_utils resamples via SNT, so scyjava needs a JVM and the Fiji jars.
# util/java/__init__.py collects them from $FIJI_PATH/{jars,plugins}; without it scyjava
# would try to resolve SNT from Maven at run time, which the flag below forbids.
export JAVA_HOME=/opt/conda/lib/jvm
export PATH="$JAVA_HOME/bin:$PATH"
export SCYJAVA_DISABLE_JDK_DOWNLOAD=1
export FIJI_PATH=/data/Fiji-builds/Fiji.app
# The two flags do different jobs and only one of them costs anything.
#
# -Xms is the heap claimed at JVM startup. The previous -Xms32g -Xmx32g claimed 32 GB
# immediately, so the stage could not start in a container smaller than that whatever it
# actually used. That was the floor under its 120 GB request, and it is what 1g fixes.
#
# -Xmx is only a ceiling: the JVM commits pages as it touches them, so a high value costs
# nothing unless reached. It is set well above need deliberately, because exceeding it is
# a hard OutOfMemoryError that loses the run, while overshooting it costs nothing.
#
# For scale: resample_swcs holds one snt.Tree at a time, and the largest specimen-space
# reconstruction in run ae8edfbf is 33 MB of text, roughly 600k nodes -- a few hundred MB
# loaded. 16g is about 30x that.
#
# The container must be able to satisfy -Xmx plus JVM non-heap overhead (metaspace,
# thread stacks, JIT) and the Python process, so it should stay at 48 GB or more.
export JAVA_OPTS="--add-opens=java.base/java.lang=ALL-UNNAMED -Xms1g -Xmx16g -Djava.io.tmpdir=/scratch"

python -u run_capsule.py "$@"
